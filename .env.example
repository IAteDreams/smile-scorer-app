# Copy to .env.local and fill in. Validated at startup by lib/env.ts.

# Upstash Redis
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# The app's own URL; use your real domain in production
BETTER_AUTH_URL=http://localhost:3000

# Resend (verification emails; in development the link is logged instead)
RESEND_API_KEY=

# Supabase Postgres
POSTGRES_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for photo uploads (Project Settings, API Keys, secret key)
SUPABASE_SECRET_KEY=
# Private Storage bucket for photos (defaults to smile-scorer-pictures)
SUPABASE_PHOTO_BUCKET=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Set to true to skip AWS Rekognition and return mock scores
USE_MOCK_SCORER=false
