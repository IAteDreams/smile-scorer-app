# Copy to .env.local and fill in. Validated at startup by lib/env.ts.

# Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Supabase Postgres
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Set to true to skip AWS Rekognition and return mock scores
USE_MOCK_SCORER=false
